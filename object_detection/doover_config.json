{
    "object_detection": {
        "name": "object_detection",
        "display_name": "Object Detection",
        "description": "On-device PPE (hard hat / high-vis) and number-plate detection for camera snapshots.",
        "long_description": "README.md",
        "type": "DEV",
        "visibility": "PUB",
        "allow_many": true,
        "depends_on": [
            "platform_interface"
        ],
        "image_name": "registry.doover.com/apps/object_detection:main",
        "build_args": "--platform linux/arm64",
        "export_ui_command": "NO_EXPORT",
        "organisation_id": null
    },
    "object_detection_processor": {
        "name": "object_detection_processor",
        "display_name": "Object Detection (Cloud)",
        "description": "Cloud processor that runs PPE and number-plate inference on camera snapshots and edits the snapshot message in place with the result.",
        "long_description": "README.md",
        "type": "PRO",
        "visibility": "PUB",
        "allow_many": false,
        "depends_on": [],
        "organisation_id": null,
        "export_ui_command": "NO_EXPORT",
        "export_config_command": "export-config-processor",
        "lambda_config": {
            "Environment": {},
            "Timeout": 120,
            "MemorySize": 3072,
            "Architectures": [
                "arm64"
            ],
            "PackageType": "Image",
            "Code": {
                "ImageUri": "184499164237.dkr.ecr.ap-southeast-2.amazonaws.com/doover/object-detection-processor:main"
            }
        },
        "config_schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "",
            "title": "$default",
            "type": "object",
            "properties": {
                "ppe_detection": {
                    "title": "PPE Detection",
                    "x-name": "ppe_detection",
                    "x-hidden": false,
                    "type": "object",
                    "x-required": true,
                    "x-position": 0,
                    "properties": {
                        "enabled": {
                            "title": "Enabled",
                            "x-name": "enabled",
                            "x-hidden": false,
                            "type": [
                                "boolean",
                                "null"
                            ],
                            "x-required": false,
                            "description": "Run hard-hat / high-vis detection on incoming snapshots.",
                            "default": true,
                            "x-position": 1
                        },
                        "require_hard_hat": {
                            "title": "Require Hard Hat",
                            "x-name": "require_hard_hat",
                            "x-hidden": false,
                            "type": [
                                "boolean",
                                "null"
                            ],
                            "x-required": false,
                            "description": "Flag a person who isn't wearing a hard hat.",
                            "default": true,
                            "x-position": 2
                        },
                        "require_highvis": {
                            "title": "Require High-Vis",
                            "x-name": "require_highvis",
                            "x-hidden": false,
                            "type": [
                                "boolean",
                                "null"
                            ],
                            "x-required": false,
                            "description": "Flag a person who isn't wearing a high-vis vest.",
                            "default": true,
                            "x-position": 3
                        },
                        "minimum_confidence": {
                            "title": "Minimum Confidence",
                            "x-name": "minimum_confidence",
                            "x-hidden": false,
                            "type": [
                                "integer",
                                "null"
                            ],
                            "x-required": false,
                            "description": "Drop detections below this confidence (0-100).",
                            "default": 55,
                            "x-position": 4,
                            "x-advanced": true,
                            "minimum": 1,
                            "maximum": 100
                        },
                        "notify_on_violation": {
                            "title": "Notify On Violation",
                            "x-name": "notify_on_violation",
                            "x-hidden": false,
                            "type": [
                                "boolean",
                                "null"
                            ],
                            "x-required": false,
                            "description": "Send a notification when someone is missing required PPE.",
                            "default": true,
                            "x-position": 5
                        }
                    },
                    "additionalElements": true,
                    "required": [],
                    "x-collapsible": true,
                    "x-defaultCollapsed": false
                },
                "number_plate_recognition": {
                    "title": "Number Plate Recognition",
                    "x-name": "number_plate_recognition",
                    "x-hidden": false,
                    "type": "object",
                    "x-required": true,
                    "x-position": 1,
                    "properties": {
                        "enabled": {
                            "title": "Enabled",
                            "x-name": "enabled",
                            "x-hidden": false,
                            "type": [
                                "boolean",
                                "null"
                            ],
                            "x-required": false,
                            "description": "Detect and read vehicle number plates on incoming snapshots.",
                            "default": false,
                            "x-position": 1
                        },
                        "minimum_confidence": {
                            "title": "Minimum Confidence",
                            "x-name": "minimum_confidence",
                            "x-hidden": false,
                            "type": [
                                "integer",
                                "null"
                            ],
                            "x-required": false,
                            "description": "Drop plate detections below this confidence (0-100).",
                            "default": 40,
                            "x-position": 2,
                            "x-advanced": true,
                            "minimum": 1,
                            "maximum": 100
                        },
                        "minimum_plate_characters": {
                            "title": "Minimum Plate Characters",
                            "x-name": "minimum_plate_characters",
                            "x-hidden": false,
                            "type": [
                                "integer",
                                "null"
                            ],
                            "x-required": false,
                            "description": "Discard OCR results shorter than this many characters.",
                            "default": 4,
                            "x-position": 3,
                            "x-advanced": true,
                            "minimum": 1,
                            "maximum": 12
                        },
                        "notify_on_plate_read": {
                            "title": "Notify On Plate Read",
                            "x-name": "notify_on_plate_read",
                            "x-hidden": false,
                            "type": [
                                "boolean",
                                "null"
                            ],
                            "x-required": false,
                            "description": "Send a notification for every plate read.",
                            "default": false,
                            "x-position": 4
                        }
                    },
                    "additionalElements": true,
                    "required": [],
                    "x-collapsible": true,
                    "x-defaultCollapsed": false
                },
                "analyse_snapshots_because_of": {
                    "title": "Analyse Snapshots Because Of",
                    "x-name": "analyse_snapshots_because_of",
                    "x-hidden": false,
                    "type": "array",
                    "x-required": true,
                    "description": "Only analyse snapshots captured for these reasons. Matches the 'reason' field the camera app publishes. Empty means analyse everything.",
                    "x-position": 2,
                    "items": {
                        "enum": [
                            "schedule",
                            "manual",
                            "intruder",
                            "person",
                            "vehicle",
                            "anpr",
                            "ppe"
                        ],
                        "title": "Reason",
                        "x-name": "reason",
                        "x-hidden": false,
                        "type": [
                            "string",
                            "null"
                        ],
                        "x-required": false,
                        "description": "Snapshot reason",
                        "default": "person"
                    }
                },
                "annotate_images": {
                    "title": "Annotate Images",
                    "x-name": "annotate_images",
                    "x-hidden": false,
                    "type": [
                        "boolean",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Attach a copy of the frame with labelled boxes drawn on it.",
                    "default": true,
                    "x-position": 3
                },
                "match_detectors_to_event": {
                    "title": "Match Detectors To Event",
                    "x-name": "match_detectors_to_event",
                    "x-hidden": false,
                    "type": [
                        "boolean",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Only run the detector the camera's classification calls for: PPE on a person event, plates on a vehicle event. Halves the inference per frame and removes false findings from the model that wasn't relevant (a traffic cone read as a person on a vehicle event, for instance). Unclassified snapshots (schedule, manual, intruder) still run everything. Turn off to always run both -- worth doing if people arrive by vehicle and you need PPE checked on the vehicle event itself.",
                    "default": true,
                    "x-position": 4,
                    "x-advanced": true
                },
                "inference_size": {
                    "title": "Inference Size",
                    "x-name": "inference_size",
                    "x-hidden": false,
                    "type": [
                        "integer",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Square size (px) frames are letterboxed to before inference. Leave at 640 unless you have measured otherwise: raising it is NOT a free accuracy win. The weights are trained at 640, and on a real site frame 960 lost a person that 640 found (see the README). More CPU here buys throughput, not better detection.",
                    "default": 640,
                    "x-position": 5,
                    "x-advanced": true,
                    "minimum": 320,
                    "maximum": 1920
                },
                "dv_proc_subscriptions": {
                    "title": "Subscription",
                    "x-name": "dv_proc_subscriptions",
                    "x-hidden": false,
                    "type": "array",
                    "x-required": true,
                    "description": "A list of channels to subscribe to.",
                    "x-position": 6,
                    "items": {
                        "title": "Channel Subscription",
                        "x-name": "dv_proc_subscription",
                        "x-hidden": false,
                        "type": "string",
                        "x-required": true,
                        "description": "The name of the channel to subscribe to"
                    }
                }
            },
            "additionalElements": true,
            "required": [
                "ppe_detection",
                "number_plate_recognition",
                "analyse_snapshots_because_of",
                "dv_proc_subscriptions"
            ]
        }
    }
}